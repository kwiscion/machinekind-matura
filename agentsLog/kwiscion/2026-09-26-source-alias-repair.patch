+def record_source_ids(row):
+    source_ids = set(row['source_ids'])
+    source_ids.update(item['source_id'] for item in row['evidence'])
+    return source_ids
+
+
+def in_holdout(group, fraction, seed):
+    digest = hashlib.sha256(f'{seed}:{group}'.encode()).hexdigest()
+    return (int(digest, 16) % 10_000) / 10_000 < fraction
+
+
+def component_keys(rows):
+    """Map each source_group_id to the canonical key of its connected component.
+
+    A component links records that share a source_group_id or any source id,
+    including evidence citations. The key is the lexicographically smallest
+    source_group_id in the component, so an unlinked group keeps its previous hash.
+    """
+    parent = {}
+
+    def find(node):
+        parent.setdefault(node, node)
+        while parent[node] != node:
+            parent[node] = parent[parent[node]]
+            node = parent[node]
+        return node
+
+    def union(left, right):
+        left_root = find(left)
+        right_root = find(right)
+        if left_root == right_root:
+            return
+        if left_root > right_root:
+            left_root, right_root = right_root, left_root
+        parent[right_root] = left_root
+
+    for row in rows:
+        group_node = ('group', row['source_group_id'])
+        find(group_node)
+        for source_id in record_source_ids(row):
+            union(group_node, ('source', source_id))
+
+    groups_by_root = {}
+    for row in rows:
+        root = find(('group', row['source_group_id']))
+        groups_by_root.setdefault(root, set()).add(row['source_group_id'])
+    keys = {}
+    for groups in groups_by_root.values():
+        canonical = min(groups)
+        for group in groups:
+            keys[group] = canonical
+    return keys
+
+
+def partition_groups(rows, fraction, seed):
+    keys = component_keys(rows)
+    return {
+        group: 'holdout' if in_holdout(key, fraction, seed) else 'train'
+        for group, key in keys.items()
+    }
+
+
+def assert_record_split(rows, fraction, seed):
+    assignment = partition_groups(rows, fraction, seed)
+    grouped = {'train': set(), 'holdout': set()}
+    sourced = {'train': set(), 'holdout': set()}
+    for row in rows:
+        part = assignment[row['source_group_id']]
+        grouped[part].add(row['source_group_id'])
+        sourced[part].update(record_source_ids(row))
+    group_overlap = grouped['train'] & grouped['holdout']
+    source_overlap = sourced['train'] & sourced['holdout']
+    if group_overlap:
+        raise ValueError('Cross-partition source_group_id overlap: ' + ', '.join(sorted(group_overlap)))
+    if source_overlap:
+        raise ValueError('Cross-partition source_id overlap: ' + ', '.join(sorted(source_overlap)))
+    return assignment
+
+
